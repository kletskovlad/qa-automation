{
  "info": {
    "_postman_id": "a4c18dbc-63c4-4b5a-90d8-5fd01f0a31ba",
    "name": "Orders API — Lab 5",
    "description": "Лабораторна робота №5, варіант 5: Login, Create, Get, три однакові PUT та контрольний GET для перевірки ідемпотентності.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('статус 200', () => pm.response.to.have.status(200));",
              "pm.test('accessToken повернуто', () => pm.expect(pm.response.json().accessToken).to.be.a('string').and.not.empty);",
              "if (pm.response.code === 200 && typeof pm.response.json().accessToken === 'string') {",
              "  pm.collectionVariables.set('token', pm.response.json().accessToken);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"bob@example.com\",\n  \"password\": \"Secret123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "Create order",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('статус 201', () => pm.response.to.have.status(201));",
              "pm.test('сума з доставкою', () => pm.expect(pm.response.json().total).to.eql(560));",
              "pm.test('правильна проміжна сума', () => pm.expect(pm.response.json().subtotal).to.eql(500));",
              "pm.test('заголовок Location', () => pm.expect(pm.response.headers.get('Location')).to.eql(`/orders/${pm.response.json().id}`));",
              "pm.test('ownerId не розкривається', () => pm.expect(pm.response.json()).not.to.have.property('ownerId'));",
              "if (pm.response.code === 201 && typeof pm.response.json().id === 'string') {",
              "  pm.collectionVariables.set('orderId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"sku\": \"A\",\n      \"price\": 500,\n      \"qty\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        }
      }
    },
    {
      "name": "Get order",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('статус 200', () => pm.response.to.have.status(200));",
              "pm.test('повернуло створене замовлення', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('orderId')));",
              "pm.test('сума збережена', () => pm.expect(pm.response.json().total).to.eql(560));",
              "pm.test('ownerId не розкривається', () => pm.expect(pm.response.json()).not.to.have.property('ownerId'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders/{{orderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders",
            "{{orderId}}"
          ]
        }
      }
    },
    {
      "name": "PUT 1 — replace items",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('статус 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON заголовок', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('повна заміна позицій', () => pm.expect(pm.response.json().items).to.eql([{ sku: 'NEW', price: 400, qty: 2 }, { sku: 'EXTRA', price: 300, qty: 1 }]));",
              "pm.test('subtotal перераховано', () => pm.expect(pm.response.json().subtotal).to.eql(1100));",
              "pm.test('total перераховано', () => pm.expect(pm.response.json().total).to.eql(1100));",
              "pm.test('ownerId приховано', () => pm.expect(pm.response.json()).not.to.have.property('ownerId'));",
              "if (pm.response.code === 200 && pm.response.json().total === 1100) {",
              "  pm.collectionVariables.set('putBaseline', JSON.stringify(pm.response.json()));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"sku\": \"NEW\",\n      \"price\": 400,\n      \"qty\": 2\n    },\n    {\n      \"sku\": \"EXTRA\",\n      \"price\": 300,\n      \"qty\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/orders/{{orderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders",
            "{{orderId}}"
          ]
        }
      }
    },
    {
      "name": "PUT 2 — identical retry",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('статус 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON заголовок', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('повна заміна позицій', () => pm.expect(pm.response.json().items).to.eql([{ sku: 'NEW', price: 400, qty: 2 }, { sku: 'EXTRA', price: 300, qty: 1 }]));",
              "pm.test('subtotal перераховано', () => pm.expect(pm.response.json().subtotal).to.eql(1100));",
              "pm.test('total перераховано', () => pm.expect(pm.response.json().total).to.eql(1100));",
              "pm.test('ownerId приховано', () => pm.expect(pm.response.json()).not.to.have.property('ownerId'));",
              "pm.test('повторний PUT ідентичний першому', () => pm.expect(pm.response.json()).to.eql(JSON.parse(pm.collectionVariables.get('putBaseline'))));"
            ]
          }
        }
      ],
