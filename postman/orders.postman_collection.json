    {
      "name": "Get order after PUT",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('статус 200', () => pm.response.to.have.status(200));",
              "pm.test('збережений стан ідентичний результату PUT', () => pm.expect(pm.response.json()).to.eql(JSON.parse(pm.collectionVariables.get('putBaseline'))));",
              "pm.test('після трьох PUT лише дві нові позиції', () => pm.expect(pm.response.json().items).to.have.length(2));",
              "pm.test('новий total збережено', () => pm.expect(pm.response.json().total).to.eql(1100));",
              "pm.test('ownerId приховано', () => pm.expect(pm.response.json()).not.to.have.property('ownerId'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
